---
// A numbered procedure. The list is an ordinary ordered list in the content; this only
// sets the numerals as part numbers and draws the line the steps run down, which is the
// plate's callout leader turned vertical.
---
<div class="steps-block"><slot /></div>

<style>
  .steps-block :global(ol) {
    margin-block: 1.6em;
    padding-left: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps-block :global(ol > li) {
    position: relative;
    counter-increment: step;
    padding-left: 3.1rem;
    padding-bottom: 1.5rem;
    /* The leader runs from one step to the next and stops at the last, because it
       describes the order rather than boxing the list in. */
    border-left: 1px solid var(--line);
    margin-left: 1.1rem;
  }
  .steps-block :global(ol > li:last-child) { border-left-color: transparent; padding-bottom: 0; }
  .steps-block :global(ol > li + li) { margin-top: 0; }
  .steps-block :global(ol > li)::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: -0.15em;
    transform: translateX(-50%);
    width: 2.2rem;
    background: var(--bg);
    text-align: center;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--step-1);
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  /* The plate's own bullets would fight the numerals, so a nested list inside a step is
     set as plain indented lines. */
  .steps-block :global(ol > li > ul > li)::before { background: var(--ink-3); }

  /* On a phone the part number's gutter was taking 67px of a 375px screen, which left a
     code block inside a step 260px to live in. The numerals keep straddling the leader;
     they just take a narrower column to do it. */
  @media (max-width: 620px) {
    .steps-block :global(ol > li) { padding-left: 1.9rem; margin-left: 0.8rem; }
    .steps-block :global(ol > li)::before { width: 1.6rem; font-size: var(--step-0); }
  }
</style>
