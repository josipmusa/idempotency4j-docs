---
import Logo from './Logo.astro';
import { url } from '../lib/links';
import { REPO_URL, MAVEN_CENTRAL_URL, COPYRIGHT, LIBRARY_VERSION } from '../lib/site';
---
<footer class="foot" data-pagefind-ignore>
  <div class="shell foot__inner">
    <div class="foot__brand">
      <Logo height={18} />
      <p class="foot__ver mono">v{LIBRARY_VERSION}</p>
    </div>
    <nav class="foot__cols" aria-label="Footer">
      <div class="foot__col">
        <p class="foot__head">Read</p>
        <a class="link" href={url('/docs')}>Docs</a>
        <a class="link" href={url('/learn')}>Learn</a>
        <a class="link" href={url('/specs')}>Specs</a>
      </div>
      <div class="foot__col">
        <p class="foot__head">Get</p>
        <a class="link link--out" href={MAVEN_CENTRAL_URL} rel="noopener">Maven Central<span class="link__out" aria-hidden="true">&#8599;</span></a>
        <a class="link link--out" href={REPO_URL} rel="noopener">GitHub<span class="link__out" aria-hidden="true">&#8599;</span></a>
      </div>
      <div class="foot__col">
        <p class="foot__head">Legal</p>
        <a class="link link--out" href={`${REPO_URL}/blob/main/LICENSE`} rel="noopener">Apache License 2.0<span class="link__out" aria-hidden="true">&#8599;</span></a>
        <a class="link link--out" href={`${REPO_URL}/blob/main/NOTICE`} rel="noopener">Notice<span class="link__out" aria-hidden="true">&#8599;</span></a>
      </div>
    </nav>
    <p class="foot__copy">{COPYRIGHT}</p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem;
  }
  .foot__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(12rem, 1fr) auto;
    align-items: start;
  }
  .foot__ver {
    margin-top: 0.7rem;
    font-size: var(--step--2);
    color: var(--ink-3);
    letter-spacing: 0.08em;
  }
  .foot__cols {
    display: flex;
    gap: clamp(1.5rem, 5vw, 4rem);
    flex-wrap: wrap;
  }
  .foot__col {
    display: flex;
    flex-direction: column;
    /* Each link is only as wide as its own words: a stretched flex item gave every
       link in a column the underline of the longest one. */
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--step--1);
  }
  .foot__head {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.3rem;
  }
  .foot__copy {
    grid-column: 1 / -1;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-faint);
    font-size: var(--step--2);
    color: var(--ink-3);
  }
  @media (max-width: 760px) {
    .foot__inner { grid-template-columns: 1fr; }
  }
</style>
