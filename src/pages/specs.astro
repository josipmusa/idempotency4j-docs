---
// The specification sheet: the support matrix the homepage used to carry, given the room
// a matrix needs. One lighter moment, and it is the matrix itself arriving row by row -
// the same reveal language as everywhere else, which is what makes it a sheet being
// printed rather than a table appearing.
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import SupportMatrix from '../components/prose/SupportMatrix.astro';
import Coordinate from '../components/Coordinate.astro';
import { url } from '../lib/links';
import { LIBRARY_VERSION } from '../lib/site';

const entry = await getEntry('sheets', 'specs');
if (!entry) throw new Error('content/specs.md is missing');
const { Content } = await render(entry);
---
<Page
  title={entry.data.title}
  description={entry.data.description}
  source={`README "Requirements", version ${LIBRARY_VERSION}`}
>
  <div class="prose"><Content /></div>

  <SupportMatrix />

  <section class="get" data-reveal-group>
    <h2 class="get__h" data-reveal>The coordinate</h2>
    <div class="get__coord" data-reveal><Coordinate /></div>
    <p class="get__n" data-reveal>
      The starter brings the core, the AOP adapter and the HTTP filter. A storage module is
      a second dependency, chosen on
      <a class="link" href={url('/docs/storage/choosing')}>choosing a store</a>.
    </p>
  </section>

  <section class="not" data-reveal-group>
    <h2 class="not__h" data-reveal>What it is not</h2>
    <p class="not__n" data-reveal>
      The support matrix says what runs. The limits say what the library refuses to
      pretend: no exactly-once, no distributed transaction, no protection against an
      effect that is not inside the action you wrapped.
    </p>
    <p data-reveal>
      <a class="link" href={url('/docs/operating/limitations')}>Read the limitations</a>
    </p>
  </section>
</Page>

<style>
  .get,
  .not { margin-top: clamp(3rem, 7vw, 5rem); }
  .get__h,
  .not__h {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--step-2);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    padding-bottom: 0.7rem;
    border-bottom: 2px solid var(--line-strong);
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .get__coord { max-width: 40rem; }
  .get__n,
  .not__n {
    margin-top: 1.25rem;
    max-width: 62ch;
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.6;
  }
  .not__n { color: var(--ink-2); font-size: var(--step-0); }
  .not p + p { margin-top: 1.1rem; }
</style>
