---
/**
 * schema.org FAQPage, emitted from the `question` field every /learn article
 * carries in its frontmatter (src/content.config.ts).
 *
 * The field already states the one question an article answers, in the reader's
 * words. Emitting it as structured data is what lets an answer engine quote the
 * article against that question rather than guessing at one from the prose.
 *
 * Not a third-party script: this is inline JSON with no request attached, so it
 * does not touch the zero-third-party-requests property (docs/DECISIONS.md D15).
 */
interface Props {
  entries: { question: string; answer: string }[];
}

const { entries } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entries.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

// `<` cannot appear raw inside a script element, whatever the media type.
const serialized = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={serialized} />
