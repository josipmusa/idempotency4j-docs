---
// The 404. The plate is the one place a missing page can say something true about the
// library: a key that has no record behind it. The number is set at poster scale, the
// way a part number is stamped on a sheet that turned out to be blank.
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';

const entry = await getEntry('sheets', '404');
if (!entry) throw new Error('content/404.md is missing');
const { Content } = await render(entry);
---
<Page title={entry.data.title} description={entry.data.description}>
  <p class="gone mono" data-reveal>Absent</p>
  <div class="prose"><Content /></div>
</Page>

<style>
  /* The one word a record has when nothing is stored under the key: absent. The same
     three states the library has, and this is the first of them. */
  .gone {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--step-5);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
